[Unit]
Description=CipherPost standalone sensor agent
Documentation=https://github.com/cipherpost/cipherpost/blob/main/docs/pilot-guide.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Least privilege: capabilities for capture only, never root.
User=cipherpost
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cipherpost
EnvironmentFile=-/etc/cipherpost/agent.env
ExecStart=/usr/local/bin/cipherpost-agent --config /etc/cipherpost/agent.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
