# CipherPost environment — copy to .env and fill in (NEVER commit .env).
# See docs/auth.md and DEPLOYMENT.md.
CIPHERPOST_DATABASE_URL=postgresql+asyncpg://cipherpost:CHANGEME@localhost:5432/cipherpost
CIPHERPOST_DATABASE_URL_SYNC=postgresql+psycopg2://cipherpost:CHANGEME@localhost:5432/cipherpost
CIPHERPOST_REDIS_URL=redis://localhost:6379/0
CIPHERPOST_CELERY_BROKER_URL=redis://localhost:6379/0
CIPHERPOST_CELERY_RESULT_BACKEND=redis://localhost:6379/0
CIPHERPOST_TRUSTED_CA_BUNDLE_PATH=tests/fixtures/trusted_root.pem
CIPHERPOST_LOG_LEVEL=INFO
CIPHERPOST_LOG_FORMAT=console

# --- auth (track 1): REQUIRED in production ---
CIPHERPOST_JWT_SECRET=CHANGEME-long-random-64-chars-minimum
CIPHERPOST_ADMIN_EMAIL=admin@example.com
CIPHERPOST_ADMIN_PASSWORD=CHANGEME-on-first-login

# --- alerting ---
CIPHERPOST_ALERT_MIN_SEVERITY=high
CIPHERPOST_ALERT_WEBHOOK_URL=
CIPHERPOST_ALERT_SLACK_URL=
CIPHERPOST_SPLUNK_HEC_URL=
CIPHERPOST_SPLUNK_HEC_TOKEN=

# --- ticketing (track 4, opt-in) ---
CIPHERPOST_TICKETING_ENABLED=false
CIPHERPOST_TICKET_MIN_SEVERITY=critical
CIPHERPOST_JIRA_URL=
CIPHERPOST_JIRA_EMAIL=
CIPHERPOST_JIRA_API_TOKEN=
CIPHERPOST_JIRA_PROJECT=
