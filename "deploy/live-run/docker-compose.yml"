version: '3.8'

services:
  # --- Mail Infrastructure ---
  postfix:
    image: mailserver:latest
    container_name: cipherpost-postfix
    ports:
      - "25:25"
      - "587:587"
    environment:
      - MAILDOMAIN=lab.local
      - SASLHOSTNAME=lab.local
      - POSTFIXNETWORK=admin
      - much_PASSWORD=password
    networks:
      - mail

  dovecot:
    image: mailserver:latest
    container_name: cipherpost-dovecot
    ports:
      - "993:993"
    depends_on:
      - postfix
    networks:
      - mail

  # --- CipherPost Stack ---
  db:
    image: postgres:15-alpine
    container_name: cipherpost-db
    environment:
      - POSTGRES_USER=cipherpost
      - POSTGRES_PASSWORD=password
      - POSTGRES_DB=cipherpost
    networks:
      - backend

  redis:
    image: redis:7-alpine
    container_name: cipherpost-redis
    networks:
      - backend

  api:
    build:
      context: ../backend
      dockerfile: Dockerfile
    container_name: cipherpost-api
    environment:
      - CIPHERPOST_ENV=dev
      - CIPHERPOST_DATABASE_URL=postgresql+asyncpg://cipherpost:password@db:5432/cipherpost
      - CIPHERPOST_DATABASE_URL_SYNC=""
