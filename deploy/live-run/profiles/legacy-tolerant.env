# Profile: legacy-tolerant — TLS 1.0/1.1 allowed on SMTP, for expected findings.
# Expected when captured: protocol-version findings (weak TLS on SMTP).
TLS_PROFILE_DIR=legacy-tolerant
TLS_LEVEL=intermediate
MAIL_DOMAIN=lab.test
SSL_CERT_PATH=/certs/good.crt
SSL_KEY_PATH=/certs/good.key
# Lab-only bootstrap secrets (API binds to 127.0.0.1, CIPHERPOST_ENV=dev):
CIPHERPOST_JWT_SECRET=lab-only-jwt-secret-0123456789abcdef-0123456789abcdef
CIPHERPOST_ADMIN_PASSWORD=lab-admin-password-123
