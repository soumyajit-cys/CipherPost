# Profile: deliberately-broken — expired cert, weak ciphers, plaintext AUTH.
# Expected when captured: expired-certificate, weak-cipher-suite, and
# plaintext-AUTH evidence.
TLS_PROFILE_DIR=deliberately-broken
TLS_LEVEL=intermediate
MAIL_DOMAIN=lab.test
# Expired cert from scripts/lab_certs.sh (0-day cert, already expired):
SSL_CERT_PATH=/certs/expired.crt
SSL_KEY_PATH=/certs/expired.key
