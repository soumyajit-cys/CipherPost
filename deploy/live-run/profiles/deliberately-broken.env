# Profile: deliberately-broken — expired cert, weak ciphers, plaintext AUTH.
# Expected findings when captured: expired-certificate, weak-cipher-suite,
# plaintext-mail-protocol / plaintext AUTH evidence.
TLS_PROFILE=deliberately-broken
MAIL_DOMAIN=lab.test
LAB_USER=alice
LAB_PASS=alice-lab-pass
# Point at the expired cert generated by scripts/lab_certs.sh
CERT=/etc/lab-certs/expired.crt
KEY=/etc/lab-certs/expired.key
